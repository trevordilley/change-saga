        "takeaway": "query inventory filters explicit intent and baseline-relative newness on resolvable records only; unresolved candidates keep a separate page.",
        "reading_order": [
          "scope",
          "filters",
          "unresolved",
          "newness"
        ]
      },
      "items": [
        {

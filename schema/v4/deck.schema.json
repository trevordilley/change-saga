{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v4/deck.schema.json",
  "title": "Change Saga v4 deck",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "title",
    "role",
    "rank",
    "objective"
  ],
  "properties": {
    "version": {
      "const": 4
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "change",
        "onboarding",
        "review"
      ]
    },
    "rank": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9999
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "overview": {
      "$ref": "#/$defs/overview"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "overview": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body"
      ],
      "properties": {
        "body": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "annotations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/overviewAnnotation"
          }
        }
      }
    },
    "overviewAnnotation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "slide"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "slide": {
          "type": "string",
          "minLength": 1
        },
        "item": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}

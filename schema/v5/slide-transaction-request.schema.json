{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/slide-transaction-request.schema.json",
  "title": "Complete slide transaction request",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "operation", "request_id", "deck", "slide", "items"],
  "properties": {
    "version": {"const": 1},
    "operation": {"enum": ["create", "update", "reconcile"]},
    "request_id": {"$ref": "#/$defs/stableId"},
    "deck": {"type": "string", "minLength": 1},
    "expected_snapshot": {"type": "string"},
    "expected_snapshots": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/digest"}},
    "slide": {"$ref": "#/$defs/slide"},
    "asset": {"$ref": "#/$defs/asset"},
    "diagram": {"$ref": "https://changesaga.dev/schema/v5/diagram.schema.json", "description": "Structured source the CLI renders to the slide's SVG and stores beside it; supply it instead of asset."},
    "items": {"type": "array", "minItems": 1, "maxItems": 7, "items": {"$ref": "#/$defs/item"}}
  },
  "allOf": [
    {"oneOf": [{"required": ["asset"], "not": {"required": ["diagram"]}}, {"required": ["diagram"], "not": {"required": ["asset"]}}]},
    {"if": {"required": ["asset"]}, "then": {"properties": {"slide": {"required": ["media_type"]}}}},
    {"if": {"required": ["diagram"]}, "then": {"properties": {"slide": {"properties": {"media_type": {"const": "image/svg+xml"}}}}}},
    {"if": {"properties": {"operation": {"const": "create"}}}, "then": {"required": ["expected_snapshot"], "properties": {"expected_snapshot": {"const": "absent"}}, "not": {"required": ["expected_snapshots"]}}},
    {"if": {"properties": {"operation": {"const": "update"}}}, "then": {"required": ["expected_snapshot"], "properties": {"expected_snapshot": {"$ref": "#/$defs/digest"}}, "not": {"required": ["expected_snapshots"]}}},
    {"if": {"properties": {"operation": {"const": "reconcile"}}}, "then": {"required": ["expected_snapshots"], "not": {"required": ["expected_snapshot"]}}}
  ],
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "lowerId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "rank", "intent", "layout", "takeaway", "reading_order"],
      "properties": {
        "id": {"$ref": "#/$defs/stableId"},
        "title": {"type": "string", "minLength": 1, "maxLength": 100},
        "rank": {"type": "integer", "minimum": 0, "maximum": 9999},
        "section": {"type": "string", "maxLength": 80},
        "intent": {"enum": ["orient", "explain", "compare", "trace", "prove", "risk", "conclude"]},
        "layout": {"enum": ["hero", "diagram", "before-after", "sequence", "evidence", "risk", "custom"]},
        "media_type": {"enum": ["image/svg+xml", "image/png", "image/jpeg", "image/webp", "text/html"]},
        "takeaway": {"type": "string", "minLength": 1, "maxLength": 180},
        "reading_order": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/lowerId"}},
        "exception_rationale": {"type": "string"}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {"path": {"type": "string", "minLength": 1}, "content_base64": {"type": "string", "minLength": 1}},
      "oneOf": [{"required": ["path"]}, {"required": ["content_base64"]}]
    },
    "selector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["element", "heading", "text", "region"]},
        "element_id": {"$ref": "#/$defs/lowerId"}, "heading_id": {"$ref": "#/$defs/lowerId"},
        "exact": {"type": "string"}, "prefix": {"type": "string"}, "suffix": {"type": "string"},
        "x": {"type": "number", "minimum": 0, "maximum": 1}, "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}, "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "width", "height"],
      "properties": {"x": {"type": "number"}, "y": {"type": "number"}, "width": {"type": "number"}, "height": {"type": "number"}}
    },
    "reference": {
      "type": "object", "additionalProperties": false, "required": ["commit", "path", "start", "end", "digest", "note"],
      "properties": {
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"}, "path": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 1}, "end": {"type": "integer", "minimum": 1}, "digest": {"$ref": "#/$defs/digest"}, "note": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object", "additionalProperties": false, "required": ["version", "references"],
      "properties": {"version": {"const": 2}, "references": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/reference"}}}
    },
    "criterionLink": {
      "type": "object", "additionalProperties": false, "required": ["id", "criterion", "story_revision", "rationale"],
      "properties": {"id": {"$ref": "#/$defs/stableId"}, "criterion": {"type": "string", "pattern": "^urn:change-saga:[^:]+:story:[^:]+:criterion:[^:]+$"}, "story_revision": {"type": "string", "pattern": "^urn:change-saga:[^:]+:story:[^:]+:revision:[^:]+$"}, "rationale": {"type": "string", "minLength": 1}}
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rank", "kind", "label", "description", "selector", "evidence", "criterion_links"],
      "properties": {
        "id": {"$ref": "#/$defs/lowerId"}, "rank": {"type": "integer", "minimum": 0, "maximum": 9999},
        "kind": {"enum": ["node", "edge", "region", "transition", "statement", "risk", "metric", "example", "callout"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 100}, "description": {"type": "string", "minLength": 1, "maxLength": 240},
        "selector": {"$ref": "#/$defs/selector"}, "hotspot": {"$ref": "#/$defs/region"},
        "about": {"type": "string"}, "body": {"type": "string"}, "placement": {"type": "string"}, "leader": {"type": "string"},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "criterion_links": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/criterionLink"}}
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/documentation-link.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "target",
    "revision"
  ],
  "properties": {
    "target": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:(component|system|data-entity):[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:(component|system|data-entity):[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      ]
    }
  }
}

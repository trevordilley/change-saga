{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/name.schema.json",
  "title": "Name: one abstraction of a Plan's work, detailed by the names beneath it and checked off by the Tasks that name it",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "title",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://changesaga.dev/schema/v5/name.schema.json"
    },
    "version": {
      "const": 5
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "parent": {
      "$ref": "#/$defs/id"
    },
    "links": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "to"
        ],
        "properties": {
          "to": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "record": {
      "type": "string",
      "pattern": "^urn:change-saga:[^:]+:(term|component|system):[^:]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}

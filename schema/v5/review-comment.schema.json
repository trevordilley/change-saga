{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/review-comment.schema.json",
  "title": "Pull request review comment on a review slide or Item or on lines of the review's diff, or a reply",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "target",
    "body",
    "reviewer",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://changesaga.dev/schema/v5/review-comment.schema.json"
    },
    "version": {
      "const": 5
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "target": {
      "type": "string",
      "description": "A review slide or Item. A code-line comment on lines no Item explains may target the review itself.",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:review:[A-Za-z0-9][A-Za-z0-9._-]{0,127}(:slide:[A-Za-z0-9][A-Za-z0-9._-]{0,127}(:item:[a-z][a-z0-9-]*)?)?$"
    },
    "reply_to": {
      "$ref": "#/$defs/id"
    },
    "body": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "open",
        "resolved"
      ]
    },
    "annotation_action": {
      "enum": ["create", "update", "delete"]
    },
    "anchor": {
      "$ref": "#/$defs/anchor"
    },
    "code_line": {
      "$ref": "#/$defs/code_line"
    },
    "reviewer": {
      "$ref": "#/$defs/reviewer"
    },
    "commit": {
      "$ref": "#/$defs/commit"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {"properties": {"annotation_action": {"const": "create"}}, "required": ["annotation_action"]},
      "then": {"required": ["anchor"], "not": {"required": ["reply_to"]}}
    },
    {
      "if": {"properties": {"annotation_action": {"const": "update"}}, "required": ["annotation_action"]},
      "then": {"required": ["anchor", "reply_to"]}
    },
    {
      "if": {"properties": {"annotation_action": {"const": "delete"}}, "required": ["annotation_action"]},
      "then": {"required": ["reply_to"], "not": {"required": ["anchor"]}}
    },
    {
      "if": {"required": ["anchor"]},
      "then": {"required": ["annotation_action"]}
    },
    {
      "if": {"required": ["code_line"]},
      "then": {"not": {"anyOf": [{"required": ["reply_to"]}, {"required": ["annotation_action"]}]}}
    },
    {
      "if": {"properties": {"target": {"pattern": ":review:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"}}},
      "then": {"anyOf": [{"required": ["code_line"]}, {"required": ["reply_to"]}]}
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "commit": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "human",
            "ai"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "agent": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "code_line": {
      "description": "Lines of the review's diff: a code reference (commit, path, inclusive 1-based start..end, and the sha256 digest of exactly those lines' bytes) and the side of the diff. The commit is the head for the new side and the merge-base for the old side.",
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "path", "side", "start", "end", "digest"],
      "properties": {
        "commit": {"$ref": "#/$defs/commit"},
        "path": {"type": "string", "minLength": 1},
        "side": {"enum": ["new", "old"]},
        "start": {"type": "integer", "minimum": 1},
        "end": {"type": "integer", "minimum": 1},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "shape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {"enum": ["rect", "ellipse", "path", "highlight"]},
        "x": {"type": "number", "minimum": 0, "maximum": 1},
        "y": {"type": "number", "minimum": 0, "maximum": 1},
        "width": {"type": "number", "minimum": 0, "maximum": 1},
        "height": {"type": "number", "minimum": 0, "maximum": 1},
        "points": {"type": "array", "items": {"$ref": "#/$defs/point"}},
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "stroke_width": {"type": "number", "minimum": 0}
      }
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "coordinate_space", "shapes"],
          "properties": {
            "type": {"enum": ["region", "drawing", "highlight"]},
            "coordinate_space": {"const": "normalized"},
            "shapes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shape"}}
          }
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["type", "coordinate_space", "note"],
          "properties": {
            "type": {"const": "note"},
            "coordinate_space": {"const": "normalized"},
            "note": {
              "type": "object", "additionalProperties": false,
              "required": ["text", "x", "y"],
              "properties": {
                "text": {"type": "string", "minLength": 1, "maxLength": 2000},
                "x": {"type": "number", "minimum": 0, "maximum": 1},
                "y": {"type": "number", "minimum": 0, "maximum": 1},
                "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
              }
            }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/relation-repin.schema.json",
  "title": "Change Saga v5 relation repin",
  "description": "One immutable confirmation that a relation still holds against the pins it names. Repins are appended beside the relation and never edited, so the relation keeps its identity, its rationale, and the record of every revision anyone confirmed it against.",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "id", "relation", "rationale", "created_at"],
  "properties": {
    "$schema": { "const": "https://changesaga.dev/schema/v5/relation-repin.schema.json" },
    "version": { "const": 5 },
    "id": { "$ref": "#/$defs/id" },
    "relation": { "$ref": "#/$defs/relation_urn" },
    "from_revision": { "$ref": "#/$defs/revision_urn" },
    "to_revision": { "$ref": "#/$defs/revision_urn" },
    "from_content_digest": { "$ref": "#/$defs/digest" },
    "to_content_digest": { "$ref": "#/$defs/digest" },
    "rationale": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "request_id": { "$ref": "#/$defs/id" }
  },
  "anyOf": [
    { "required": ["from_revision"] },
    { "required": ["to_revision"] },
    { "required": ["from_content_digest"] },
    { "required": ["to_content_digest"] }
  ],
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "relation_urn": { "type": "string", "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:relation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "revision_urn": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:(story|wave|work-item|contract|test-case):[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}

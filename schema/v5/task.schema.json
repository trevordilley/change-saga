{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/task.schema.json",
  "title": "Task: one well-understood piece of a Plan's work, leading to a user story directly or through the Tasks it unblocks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "title",
    "state",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://changesaga.dev/schema/v5/task.schema.json"
    },
    "version": {
      "const": 5
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "$ref": "#/$defs/id"
    },
    "story": {
      "type": "string",
      "pattern": "^urn:change-saga:[^:]+:story:[^:]+$"
    },
    "depends_on": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "names": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "code": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "path",
          "start",
          "end",
          "digest"
        ],
        "properties": {
          "commit": {
            "type": "string",
            "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "sizing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "within_two_days"
      ],
      "properties": {
        "within_two_days": {
          "type": "boolean"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "state": {
      "enum": [
        "planned",
        "in_progress",
        "done"
      ]
    },
    "summary": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}

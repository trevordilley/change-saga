{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/plan.schema.json",
  "title": "Plan: a body of work and how it can be executed in parallel, as a slide deck and Tasks",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "title",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://changesaga.dev/schema/v5/plan.schema.json"
    },
    "version": {
      "const": 5
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "phases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "checkpoint": {
            "type": "object",
            "additionalProperties": false,
            "description": "Makes the phase a checkpoint: it holds no Tasks and covers every Task since the previous checkpoint, reviewed together before the work after it starts.",
            "properties": {
              "review": {
                "$ref": "#/$defs/id"
              },
              "passed": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "at",
                  "by",
                  "reason"
                ],
                "properties": {
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "by": {
                    "type": "string",
                    "minLength": 1
                  },
                  "agent": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "prototypes": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^urn:change-saga:[^:]+:prototype:[^:]+$"
      }
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "checkpoint_passer": {
      "enum": [
        "person",
        "agent"
      ],
      "description": "Who passes the Plan's checkpoints: a person, or an agent unless what it found is surprising or urgent. Absent means a person."
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}

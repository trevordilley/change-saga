{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/deprecation-event.schema.json",
  "title": "App Saga deprecation lifecycle event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "deprecation",
    "parents",
    "state",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://changesaga.dev/schema/v5/deprecation-event.schema.json"
    },
    "version": {
      "const": 5
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "deprecation": {
      "$ref": "#/$defs/record_urn"
    },
    "parents": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/event_urn"
      }
    },
    "state": {
      "enum": [
        "active",
        "withdrawn"
      ]
    },
    "reason": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "record_urn": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:deprecation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "event_urn": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:deprecation:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:event:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "parents": {
            "minItems": 1
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ],
        "properties": {
          "reason": {
            "type": "string",
            "pattern": "\\S"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "parents": {
            "maxItems": 0
          }
        }
      },
      "then": {
        "properties": {
          "state": {
            "const": "active"
          }
        }
      }
    }
  ]
}

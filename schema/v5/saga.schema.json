{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/saga.schema.json",
  "title": "Change Saga v5 report manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "title", "source"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 5 },
    "id": { "$ref": "#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri",
          "not": { "pattern": "^[A-Za-z][A-Za-z0-9+.-]*://[^/?#]*@" },
          "description": "Canonical absolute repository identity without URL userinfo credentials."
        }
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}

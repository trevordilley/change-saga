{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/data-entity-event.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "record",
    "parents",
    "created_at",
    "state"
  ],
  "properties": {
    "$schema": {
      "const": "https://changesaga.dev/schema/v5/data-entity-event.schema.json"
    },
    "version": {
      "const": 5
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "record": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "parents": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:event:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "state": {
      "enum": [
        "active",
        "retired"
      ]
    },
    "reason": {
      "type": "string"
    }
  }
}

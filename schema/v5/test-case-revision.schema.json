{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/test-case-revision.schema.json",
  "title": "Change Saga v5 full test-case revision",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "version", "id", "test_case", "parents", "title", "coverage_kinds", "automation", "preconditions", "steps", "expected_result", "created_at"],
  "properties": {
    "$schema": { "const": "https://changesaga.dev/schema/v5/test-case-revision.schema.json" },
    "version": { "const": 5 },
    "id": { "$ref": "#/$defs/id" },
    "test_case": { "$ref": "#/$defs/test_case_urn" },
    "parents": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/revision_urn" }
    },
    "title": { "type": "string", "minLength": 1 },
    "coverage_kinds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["positive", "negative", "edge"] }
    },
    "automation": { "enum": ["manual", "automated", "hybrid"] },
    "preconditions": {
      "type": "array",
      "maxItems": 10000,
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "action", "expected_result"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "action": { "type": "string", "minLength": 1 },
          "expected_result": { "type": "string", "minLength": 1 }
        }
      }
    },
    "expected_result": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "request_id": { "$ref": "#/$defs/id" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "test_case_urn": { "type": "string", "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:test-case:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "revision_urn": { "type": "string", "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:test-case:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" }
  }
}

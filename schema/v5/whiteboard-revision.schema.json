{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/whiteboard-revision.schema.json",
  "title": "Immutable whiteboard document revision",
  "description": "A complete immutable diagram, including optional element-owned code evidence and semantic links. Reassessment publishes a new revision; historical pins are never rewritten.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "parents",
    "name",
    "document",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://changesaga.dev/schema/v5/whiteboard-revision.schema.json"
    },
    "version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "parents": {
      "type": "array",
      "maxItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "document": {
      "$ref": "diagram.schema.json"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/flag-revision.schema.json",
  "title": "App Saga complete feature flag revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "flag",
    "parents",
    "description",
    "targets",
    "created_at"
  ],
  "properties": {
    "$schema": {
      "const": "https://changesaga.dev/schema/v5/flag-revision.schema.json"
    },
    "version": {
      "const": 5
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "flag": {
      "$ref": "#/$defs/record_urn"
    },
    "parents": {
      "type": "array",
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/revision_urn"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": {
        "anyOf": [
          {
            "$ref": "#/$defs/story_urn"
          },
          {
            "$ref": "#/$defs/feature_urn"
          }
        ]
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "record_urn": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:flag:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "revision_urn": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:flag:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "story_urn": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:story:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "feature_urn": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:feature:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/technical-definition.schema.json",
  "title": "Technical inventory definition input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "explanation"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "explanation": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "enum": [
        "proposed",
        "implemented"
      ]
    },
    "baseline": {
      "type": "string",
      "minLength": 1
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "commit"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "code": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "commit",
          "path",
          "start",
          "end",
          "note"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "commit": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "start": {
            "type": "integer",
            "minimum": 1
          },
          "end": {
            "type": "integer",
            "minimum": 1
          },
          "digest": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "revision"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:component:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:component:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "interactions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "from",
          "to",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "enum": [
              "proposed",
              "implemented"
            ]
          },
          "code": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commit",
                "path",
                "start",
                "end",
                "note"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "commit": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    "fields": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "type": {
            "type": "string",
            "maxLength": 200
          },
          "keys": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "primary",
                "foreign",
                "unique",
                "partition"
              ]
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "holders": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component",
          "role"
        ],
        "properties": {
          "component": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "revision"
            ],
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:component:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:component:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          },
          "role": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "meaning",
          "destination",
          "explanation",
          "intent"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "meaning": {
            "enum": [
              "association",
              "production"
            ]
          },
          "destination": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "revision"
            ],
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          },
          "cardinality": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "destination"
            ],
            "properties": {
              "owner": {
                "enum": [
                  "unknown",
                  "0..1",
                  "1",
                  "0..many",
                  "1..many"
                ]
              },
              "destination": {
                "enum": [
                  "unknown",
                  "0..1",
                  "1",
                  "0..many",
                  "1..many"
                ]
              }
            }
          },
          "flow": {
            "enum": [
              "owner_to_destination",
              "destination_to_owner"
            ]
          },
          "intent": {
            "enum": [
              "proposed",
              "implemented"
            ]
          },
          "code": {
            "type": "array",
            "minItems": 0,
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "commit",
                "path",
                "start",
                "end",
                "note"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                },
                "commit": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "start": {
                  "type": "integer",
                  "minimum": 1
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "digest": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "meaning": {
                  "const": "association"
                }
              }
            },
            "then": {
              "required": [
                "cardinality"
              ],
              "not": {
                "required": [
                  "flow"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "meaning": {
                  "const": "production"
                }
              }
            },
            "then": {
              "required": [
                "flow",
                "label"
              ],
              "not": {
                "required": [
                  "cardinality"
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "intent": {
                  "const": "implemented"
                }
              }
            },
            "then": {
              "required": [
                "code"
              ],
              "properties": {
                "code": {
                  "minItems": 1
                }
              }
            }
          }
        ]
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "media_type",
        "digest"
      ],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^assets/[0-9a-f]{64}\\.svg$"
        },
        "media_type": {
          "const": "image/svg+xml"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "directory": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "revision"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "bindings": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "element"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "element": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9._-]{0,127}$"
          },
          "entity": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "target",
              "revision"
            ],
            "properties": {
              "target": {
                "type": "string",
                "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              },
              "revision": {
                "type": "string",
                "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          },
          "relationship": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "owner",
              "id"
            ],
            "properties": {
              "owner": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "target",
                  "revision"
                ],
                "properties": {
                  "target": {
                    "type": "string",
                    "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  },
                  "revision": {
                    "type": "string",
                    "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
                  }
                }
              },
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
              }
            }
          }
        },
        "oneOf": [
          {
            "required": [
              "entity"
            ]
          },
          {
            "required": [
              "relationship"
            ]
          }
        ]
      }
    },
    "erd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target",
        "revision"
      ],
      "properties": {
        "target": {
          "type": "string",
          "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:erd:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:erd:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        }
      }
    },
    "feature": {
      "type": "string",
      "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:feature:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "pins": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "revision"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "revision": {
            "type": "string",
            "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:revision:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          }
        }
      }
    },
    "removals": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "explanation"
        ],
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^urn:change-saga:[A-Za-z0-9][A-Za-z0-9._-]{0,127}:data-entity:[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
          },
          "explanation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}

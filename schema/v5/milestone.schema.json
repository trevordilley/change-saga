{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://changesaga.dev/schema/v5/milestone.schema.json",
  "title": "Milestone",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "version",
    "id",
    "title"
  ],
  "properties": {
    "$schema": {
      "const": "https://changesaga.dev/schema/v5/milestone.schema.json"
    },
    "version": {
      "const": 5
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "pattern": "^\\S(?:[^\\r\\n\\t]*\\S)?$"
    }
  }
}

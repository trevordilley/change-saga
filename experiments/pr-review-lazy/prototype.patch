+package server
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"net/http/httptest"
+	"net/url"
+	"reflect"
+	"strings"
+	"testing"
+
+	"github.com/twentyideas/changesaga/internal/coderef"
+	"github.com/twentyideas/changesaga/internal/gitdiff"
+	"github.com/twentyideas/changesaga/internal/reviewstate"
+	"github.com/twentyideas/changesaga/internal/reviewstore"
+	"github.com/twentyideas/changesaga/internal/saga"
+)
+
+func TestReviewItemPagesPreserveExactRowsAndVisitOnlyNeededReferences(t *testing.T) {
+	refs := []coderef.Reference{{Path: "first"}, {Path: "second"}, {Path: "unchanged"}}
+	first := &reviewDiffView{Path: "first", Location: "exact:first", Lines: make([]reviewDiffLine, reviewItemPageRows)}
+	second := &reviewDiffView{Path: "second", Location: "exact:second", Note: "Stale reference: showing every change.", Lines: make([]reviewDiffLine, reviewItemPageRows+4)}
+	for i := range first.Lines {
+		first.Lines[i] = reviewDiffLine{Kind: "add", New: fmt.Sprint(i), Text: fmt.Sprint(i)}
+	}
+	for i := range second.Lines {
+		second.Lines[i] = reviewDiffLine{Kind: "del", Old: fmt.Sprint(i), Text: fmt.Sprint(i)}
+	}
+	views := map[string]*reviewDiffView{"first": first, "second": second, "unchanged": {Path: "unchanged", Location: "exact:unchanged", Note: "The diff could not be read from this checkout."}}
+	calls := map[string]int{}
+	read := func(ref coderef.Reference) *reviewDiffView { calls[ref.Path]++; return views[ref.Path] }
+	cursor := reviewItemCursor{Target: "item", Snapshot: "shown"}
+	var gotFirst, gotSecond []reviewDiffLine
+	notes := []string{}
+	for cursor.Reference < len(refs) {
+		page, next, returned, err := reviewItemDiffPage(refs, cursor, read)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if returned > reviewItemPageRows || returned == 0 {
+			t.Fatalf("unbounded/nonprogress page: %d", returned)
+		}
+		for _, view := range page {
+			switch view.Path {
+			case "first":
+				gotFirst = append(gotFirst, view.Lines...)
+			case "second":
+				gotSecond = append(gotSecond, view.Lines...)
+			default:
+				notes = append(notes, view.Note)
+			}
+		}
+		cursor = next
+	}
+	if !reflect.DeepEqual(gotFirst, first.Lines) || !reflect.DeepEqual(gotSecond, second.Lines) || len(notes) != 1 || !strings.Contains(notes[0], "could not be read") {
+		t.Fatal("exact rows or unresolved diagnostic lost")
+	}
+	if calls["first"] != 1 || calls["second"] != 2 || calls["unchanged"] != 1 {
+		t.Fatalf("recomputed previous references: %v", calls)
+	}
+	_, partial, _, _ := reviewItemDiffPage(refs, reviewItemCursor{Reference: 1}, read)
+	second.Lines[0].Text = "changed patch"
+	if _, _, _, err := reviewItemDiffPage(refs, partial, read); err == nil {
+		t.Fatal("changed patch spliced into old cursor")
+	}
+}
+
+func reviewItemHTML(t *testing.T, handler http.Handler, page, target string) string {
+	t.Helper()
+	marker := `data-review-item-target="` + target + `" data-review-item-snapshot="`
+	_, after, found := strings.Cut(page, marker)
+	if !found {
+		t.Fatal("missing lazy Item descriptor")
+	}
+	snapshot, _, _ := strings.Cut(after, `"`)
+	response := getPage(t, handler, "/reviews/pr-7/item?target="+url.QueryEscape(target)+"&snapshot="+snapshot)
+	var payload reviewItemResponse
+	if response.Code != 200 || json.Unmarshal(response.Body.Bytes(), &payload) != nil {
+		t.Fatalf("Item: %d %s", response.Code, response.Body)
+	}
+	return payload.HTML
+}
+
+func TestReviewItemEndpointIsLazyFreshPinnedAndReadOnly(t *testing.T) {
+	f := newServerReviewFixture(t)
+	a, handler := reviewApp(t, f, gitdiff.Range{})
+	get := func(path string) *httptest.ResponseRecorder {
+		response := httptest.NewRecorder()
+		handler.ServeHTTP(response, httptest.NewRequest("GET", path, nil))
+		return response
+	}
+	page := getPage(t, handler, "/reviews/pr-7").Body.String()
+	if strings.Contains(page, `class="review-line `) || strings.Contains(page, `class="review-item-panel"`) {
+		t.Fatal("initial page eagerly ships Item diff body")
+	}
+	document, _, _ := saga.Load(f.root)
+	review := document.FindReview("pr-7")
+	slide := review.Slide("queue")
+	target := slide.Items[0].Target
+	rng, _ := reviewstate.ResolveRange(context.Background(), f.repo, review)
+	snapshot := a.reviewSnapshot(slide, &rng)
+	path := "/reviews/pr-7/item?target=" + url.QueryEscape(target) + "&snapshot=" + snapshot
+	first := get(path)
+	var payload reviewItemResponse
+	if first.Code != 200 || json.Unmarshal(first.Body.Bytes(), &payload) != nil {
+		t.Fatalf("Item: %d %s", first.Code, first.Body)
+	}
+	for _, want := range []string{"postgres", "sqs", `review-line add`, `review-line del`, slide.Items[0].Code[0].References[0].Location().String()} {
+		if !strings.Contains(payload.HTML, want) {
+			t.Fatalf("missing exact reference %q", want)
+		}
+	}
+	if first.Header().Get("Cache-Control") != "no-store" || payload.Snapshot != snapshot || payload.Returned > reviewItemPageRows {
+		t.Fatal("unbounded or unpinned Item response")
+	}
+	if _, err := reviewstore.Comment(f.root, reviewstore.Remark{Review: review.ID, Target: target, Body: "External new feedback", Reviewer: saga.ReviewerIdentity{Kind: "human"}}); err != nil {
+		t.Fatal(err)
+	}
+	fresh := get(path)
+	if !strings.Contains(fresh.Body.String(), "External new feedback") {
+		t.Fatal("repeat open reused stale feedback")
+	}
+	if bad := get(path + "&cursor=bad"); bad.Code != 400 {
+		t.Fatalf("bad cursor %d", bad.Code)
+	}
+	if retry := get(path); retry.Code != 200 {
+		t.Fatal("failed load poisoned retry")
+	}
+	serverGit(t, f.repo, "commit", "--allow-empty", "-m", "advance reviewed head")
+	if stale := get(path); stale.Code != 409 {
+		t.Fatalf("unseen head accepted %d", stale.Code)
+	}
+	doc, validation, _ := saga.Load(f.root)
+	if !validation.Valid || len(doc.FindReview(review.ID).Approvals) != 0 || len(doc.FindReview(review.ID).Comments) != 1 {
+		t.Fatal("read-only Item endpoint changed review records")
+	}
+}

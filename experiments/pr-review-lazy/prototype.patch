diff --git a/internal/server/reviewasyncitem.go b/internal/server/reviewasyncitem.go
new file mode 100644
index 0000000..f2e9971
--- /dev/null
+++ b/internal/server/reviewasyncitem.go
@@ -0,0 +1,194 @@
+package server
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/base64"
+	"encoding/hex"
+	"encoding/json"
+	"fmt"
+	"net/http"
+
+	"github.com/twentyideas/changesaga/internal/coderef"
+	"github.com/twentyideas/changesaga/internal/coderesolve"
+	"github.com/twentyideas/changesaga/internal/reviewstate"
+	"github.com/twentyideas/changesaga/internal/saga"
+)
+
+const reviewItemPageRows = 1000
+
+type reviewItemCursor struct {
+	Target    string `json:"target"`
+	Snapshot  string `json:"snapshot"`
+	Reference int    `json:"reference"`
+	Line      int    `json:"line"`
+	Digest    string `json:"digest,omitempty"`
+}
+
+type reviewItemResponse struct {
+	Target   string `json:"target"`
+	Snapshot string `json:"snapshot"`
+	HTML     string `json:"html"`
+	Next     string `json:"next"`
+	Returned int    `json:"returned"`
+}
+
+func reviewItemReferences(item *saga.Item) []coderef.Reference {
+	var refs []coderef.Reference
+	for _, file := range item.Code {
+		refs = append(refs, file.References...)
+	}
+	return refs
+}
+
+func reviewDiffDigest(view *reviewDiffView) string {
+	data, _ := json.Marshal(view)
+	sum := sha256.Sum256(data)
+	return hex.EncodeToString(sum[:])
+}
+
+// reviewItemDiffPage visits only references needed for this page. A cursor
+// inside a long reference binds its exact projection, so a changed patch cannot
+// silently splice different line offsets into already displayed evidence.
+func reviewItemDiffPage(refs []coderef.Reference, cursor reviewItemCursor, read func(coderef.Reference) *reviewDiffView) ([]*reviewDiffView, reviewItemCursor, int, error) {
+	if cursor.Reference < 0 || cursor.Reference > len(refs) || cursor.Line < 0 || (cursor.Reference == len(refs) && cursor.Line != 0) {
+		return nil, cursor, 0, fmt.Errorf("invalid Item cursor")
+	}
+	var views []*reviewDiffView
+	returned := 0
+	for cursor.Reference < len(refs) && returned < reviewItemPageRows {
+		view := read(refs[cursor.Reference])
+		count := len(view.Lines)
+		if count == 0 {
+			count = 1
+		}
+		digest := reviewDiffDigest(view)
+		if cursor.Line >= count || (cursor.Line > 0 && cursor.Digest != digest) {
+			return nil, cursor, 0, errReviewViewChanged
+		}
+		take := min(count-cursor.Line, reviewItemPageRows-returned)
+		part := *view
+		if len(view.Lines) > 0 {
+			part.Lines = view.Lines[cursor.Line : cursor.Line+take]
+		}
+		views = append(views, &part)
+		returned += take
+		cursor.Line += take
+		if cursor.Line == count {
+			cursor.Reference++
+			cursor.Line = 0
+			cursor.Digest = ""
+		} else {
+			cursor.Digest = digest
+		}
+	}
+	return views, cursor, returned, nil
+}
+
+func (a *app) reviewItemSurface(w http.ResponseWriter, r *http.Request) {
+	document := a.loadReviewDocument(w)
+	if document == nil {
+		return
+	}
+	review := document.FindReview(r.PathValue("id"))
+	target := r.URL.Query().Get("target")
+	if review == nil {
+		http.NotFound(w, r)
+		return
+	}
+	slide := reviewTargetSlide(review, target)
+	var item *saga.Item
+	if slide != nil {
+		for _, candidate := range slide.Items {
+			if candidate.Target == target {
+				item = candidate
+				break
+			}
+		}
+	}
+	if item == nil {
+		http.NotFound(w, r)
+		return
+	}
+	rng, err := reviewstate.ResolveRange(r.Context(), a.sourceDir, review)
+	if err != nil {
+		http.Error(w, "The source comparison could not be read. "+err.Error(), http.StatusConflict)
+		return
+	}
+	snapshot := a.reviewSnapshot(slide, &rng)
+	if snapshot == "" || r.URL.Query().Get("snapshot") != snapshot {
+		reviewWriteError(w, errReviewViewChanged)
+		return
+	}
+	cursor := reviewItemCursor{Target: target, Snapshot: snapshot}
+	first := r.URL.Query().Get("cursor") == ""
+	if !first {
+		raw, err := base64.RawURLEncoding.DecodeString(r.URL.Query().Get("cursor"))
+		if err != nil || len(raw) > 4096 || json.Unmarshal(raw, &cursor) != nil {
+			http.Error(w, "invalid Item cursor", http.StatusBadRequest)
+			return
+		}
+		if cursor.Target != target || cursor.Snapshot != snapshot {
+			reviewWriteError(w, errReviewViewChanged)
+			return
+		}
+	}
+	resolver, err := coderesolve.New(r.Context(), a.sourceDir)
+	if err == nil {
+		defer resolver.Close()
+	} else {
+		resolver = nil
+	}
+	refs := reviewItemReferences(item)
+	// Integration hook: construct newReviewDiffs once here after combining the
+	// request-local patch helper; replace the closure's one-shot call below.
+	views, next, returned, err := reviewItemDiffPage(refs, cursor, func(ref coderef.Reference) *reviewDiffView { return a.referenceDiff(r.Context(), resolver, ref, rng) })
+	if err != nil {
+		reviewWriteError(w, err)
+		return
+	}
+	var html bytes.Buffer
+	if first {
+		view := &reviewItemView{Item: item, DOMID: domID(item.Target), Diffs: views, Threads: threadViewsFor(reviewstate.Threads(review.Comments), target, review.ID, a.mutationToken, review.Merged != nil)}
+		if item.Record != "" {
+			view.RecordHref, view.RecordLabel, view.RecordKind = recordHref(document, item.Record), recordLabel(item.Record), reviewRecordKind(item.Record)
+		}
+		err = reviewTemplates.ExecuteTemplate(&html, "review-item-panel", view)
+		if err == nil {
+			err = reviewTemplates.ExecuteTemplate(&html, "review-comment-form", reviewCommentFormView{ReviewID: review.ID, Token: a.mutationToken, Target: target, Label: item.Label, Frozen: review.Merged != nil})
+		}
+	} else {
+		for _, view := range views {
+			if err = reviewTemplates.ExecuteTemplate(&html, "review-diff", view); err != nil {
+				break
+			}
+		}
+	}
+	if err != nil {
+		http.Error(w, "The linked code could not be rendered.", http.StatusInternalServerError)
+		return
+	}
+	// No evidence result survives an intervening authoring/source change. A fresh
+	// load includes dirty/new records and preserves existing validation behavior.
+	fresh := a.loadReviewDocument(w)
+	if fresh == nil {
+		return
+	}
+	current := fresh.FindReview(review.ID)
+	if current == nil {
+		reviewWriteError(w, errReviewViewChanged)
+		return
+	}
+	currentRange, err := reviewstate.ResolveRange(r.Context(), a.sourceDir, current)
+	if err != nil || a.reviewSnapshot(reviewTargetSlide(current, target), &currentRange) != snapshot {
+		reviewWriteError(w, errReviewViewChanged)
+		return
+	}
+	response := reviewItemResponse{Target: target, Snapshot: snapshot, HTML: html.String(), Returned: returned}
+	if next.Reference < len(refs) {
+		encoded, _ := json.Marshal(next)
+		response.Next = base64.RawURLEncoding.EncodeToString(encoded)
+	}
+	writeIncrementalHeaders(w, "application/json")
+	_ = json.NewEncoder(w).Encode(response)
+}

+package server
+
+const reviewItemJavaScript = `
+  let reviewItemRequest = null;
+  function cancelReviewItem() {
+    if(reviewItemRequest) reviewItemRequest.controller.abort();
+    reviewItemRequest=null;
+  }
+  function openReviewItem(source,opener) {
+    restoreDrawerContent();
+    const surface=document.createElement('div'); surface.className='review-item-surface';
+    surface.dataset.reviewTarget=source.dataset.reviewItemTarget;
+    const content=document.createElement('div'),status=document.createElement('p');
+    status.setAttribute('role','status'); surface.append(content,status);
+    q('.drawer-body').append(surface);configureDrawer('code','Linked code');showDrawer(opener);
+    const request={controller:new AbortController(),surface,cursor:'',first:true};reviewItemRequest=request;
+    const current=()=>reviewItemRequest===request && surface.isConnected && !request.controller.signal.aborted;
+    async function load() {
+      while(current()) {
+        status.replaceChildren(document.createTextNode('Loading linked code…'));surface.dataset.state='loading';
+        try {
+          const feedbackAtStart=reviewAsync?.feedbackFor(source.dataset.reviewItemTarget);
+          const url=new URL(source.dataset.reviewItemHref,location.href);
+          url.searchParams.set('target',source.dataset.reviewItemTarget);url.searchParams.set('snapshot',source.dataset.reviewItemSnapshot);
+          if(request.cursor)url.searchParams.set('cursor',request.cursor);
+          const response=await fetch(url,{headers:{Accept:'application/json'},cache:'no-store',signal:request.controller.signal});
+          if(!response.ok)throw new Error((await response.text()).trim() || 'Linked code could not be loaded.');
+          const result=await response.json();
+          if(!current())return;
+          if(result.snapshot!==source.dataset.reviewItemSnapshot || result.target!==source.dataset.reviewItemTarget)throw new Error('The linked code no longer matches this slide. Reload and inspect the current slide.');
+          const template=document.createElement('template');template.innerHTML=result.html;
+          if(request.first) {content.replaceChildren(template.content);request.first=false;reviewAsync?.reapplyAfter(source.dataset.reviewItemTarget,feedbackAtStart);}
+          else q('[data-review-item-diffs]',content).append(template.content);
+          highlightCode(content);
+          // A save from the previous drawer may have finished while this GET
+          // was in flight. Preserve its newer confirmed feedback and drafts.
+          request.cursor=result.next || '';
+          if(!request.cursor){surface.dataset.state='ready';status.remove();return;}
+        } catch(error) {
+          if(!current() || error.name==='AbortError')return;
+          surface.dataset.state='error';status.replaceChildren(document.createTextNode(error.message+' '));
+          const retry=document.createElement('button');retry.type='button';retry.textContent='Retry linked code';
+          retry.addEventListener('click',()=>void load(),{once:true});status.append(retry);return;
+        }
+      }
+    }
+    void load();
+  }
+`

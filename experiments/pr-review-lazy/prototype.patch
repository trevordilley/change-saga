+test("lazy Item failures retry and late responses cannot replace another drawer", async ({page,sagaRepositories}) => {
+  authorReview(sagaRepositories);const running=await startSagaServer(sagaRepositories);
+  try {
+    await page.goto(`${running.baseURL}/reviews/pr-1`);await page.waitForLoadState('networkidle');
+    const greeting=page.locator('.review-deck-slide[data-slide-target$=":greeting"]');
+    const theme=page.locator('.review-deck-slide[data-slide-target$=":theme"]');
+    expect(await page.locator('template[data-review-item-target]').first().innerHTML()).toBe('');
+    await greeting.locator('.landmark-menu > summary').click();
+    const open=greeting.locator('.landmark-list [data-open-diffs]').first();
+    await page.route('**/reviews/pr-1/item?**',route=>route.fulfill({status:500,body:'Temporary diff failure.'}),{times:1});
+    await open.click();await page.getByRole('button',{name:'Retry linked code'}).click();
+    await expect(page.locator('.review-item-surface')).toHaveAttribute('data-state','ready');
+    await expect(page.locator('#review-drawer')).toContainText('"hello, " + name');
+    await page.locator('[data-close-drawer]').last().click();
+    let release!:()=>void;const held=new Promise<void>(resolve=>release=resolve);
+    let received!:()=>void;const arrived=new Promise<void>(resolve=>received=resolve);
+    await page.route('**/reviews/pr-1/item?**',async route=>{const response=await route.fetch();received();await held;await route.fulfill({response});},{times:1});
+    await open.click();await arrived;await page.locator('[data-close-drawer]').last().click();
+    await page.locator('[data-slide-thumbnail][data-slide-target$=":theme"]').click();
+    await theme.locator('.landmark-menu > summary').click();await theme.locator('.landmark-list [data-open-diffs]').first().click();
+    await expect(page.locator('.review-item-surface')).toHaveAttribute('data-state','ready');
+    release();await page.waitForLoadState('networkidle');
+    await expect(page.locator('#review-drawer [data-review-item-panel]')).toHaveAttribute('data-review-target',/slide:theme:item:change$/);
+    await expect(page.locator('#review-drawer')).not.toContainText('"hello, " + name');
+  } finally {await stopSagaServer(running);}
+});

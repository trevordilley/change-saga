    {
      "id": "resolve",
      "kind": "node",
      "shape": "service",
      "label": "Token references",
      "detail": "@name paints light + var()",
      "note": "Each colour is written twice: `fill=\"#ffffff\" style=\"fill:var(--diagram-normal-fill,#ffffff)\"`. An inline style, because `var()` is **unreliable in SVG presentation attributes**; the light attribute keeps rasterizers drawing the light slide. Authors may write `@accent` or any colour token; hex stays as authored.",
      "x": 30,
      "y": 60,
      "width": 520,
      "height": 100,
      "parent": "render",
      "style": "primary"
    },
    {
      "id": "standalone",
      "kind": "node",
      "shape": "document",
      "label": "Standalone SVG",
      "detail": "dark values under prefers-color-scheme",
      "note": "Declared by the same pass: the SVG's own style names only the tokens it uses, with `color-scheme: light dark`, so it themes itself on a code host.",
      "x": 30,
      "y": 220,
      "width": 520,
      "height": 100,
      "parent": "render",
      "style": "normal"
    },

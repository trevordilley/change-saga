      "style": "normal",
      "color": "blue"
    },
    {
      "id": "parser",
      "kind": "node",
      "shape": "service",
      "label": "Parse",
      "detail": "blocks, tokens, lines",
      "note": "Refused anywhere outside a comment: `\\`, `@`, `url(`, `\u003c`, `!`, control characters. Only `:root` and `:root[data-theme=\"dark\"]`, each once; only `--\u003ccontract token\u003e`.",
      "x": 30,
      "y": 50,
      "width": 360,
      "height": 100,
      "parent": "strict",
      "style": "primary"
    },
    {
      "id": "values",
      "kind": "node",
      "shape": "service",
      "label": "Value grammars",
      "detail": "colour, length, font, shadow",
      "note": "Colours become hex; lengths are 0 or px/rem/em; fonts are quoted names or plain words; shadows are `[inset] x y [blur [spread]] colour`.",
      "x": 30,
      "y": 170,
      "width": 360,
      "height": 100,
      "parent": "strict",
      "style": "normal"
    },
    {
      "id": "cascade",

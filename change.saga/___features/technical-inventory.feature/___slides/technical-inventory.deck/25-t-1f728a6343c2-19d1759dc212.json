                  "digest": "sha256:515d7e93ad8912c276874ef2792fa9c06c60da7827da843b30b031595499a849",
                  "note": "Intent and newness filters apply only to resolvable candidates."
                }
              ]
            }
          ],
          "criterion_links": [
            {
              "id": "filters-inventory-query-technical-context-filter-proposed",
              "criterion": "urn:change-saga:change-saga:story:inventory-query-technical-context:criterion:filter-proposed",
              "story_revision": "urn:change-saga:change-saga:story:inventory-query-technical-context:revision:r2",
              "rationale": "Proposed records are filtered by the explicit state of the selected revision, which each result reports."
            },
            {
              "id": "filters-inventory-proposed-and-existing-explicit-status",
              "criterion": "urn:change-saga:change-saga:story:inventory-proposed-and-existing:criterion:explicit-status",
              "story_revision": "urn:change-saga:change-saga:story:inventory-proposed-and-existing:revision:r3",

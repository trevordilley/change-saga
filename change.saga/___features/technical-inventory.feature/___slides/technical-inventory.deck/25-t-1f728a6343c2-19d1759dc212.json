                  "end": 97,
                  "digest": "sha256:fee1e4eebac8e22290dfc41b7033a3191e22220fc9ef732b11a94a69288a7831",
                  "note": "Feature scope follows only declared pins at each saved revision and returns the establishing paths."
                }
              ]
            }
          ],
          "criterion_links": [
            {
              "id": "scope-inventory-query-technical-context-scoped-roadmap",
              "criterion": "urn:change-saga:change-saga:story:inventory-query-technical-context:criterion:scoped-roadmap",
              "story_revision": "urn:change-saga:change-saga:story:inventory-query-technical-context:revision:r2",
              "rationale": "Scope comes from the feature's declared Item links and returns those paths, not unrelated proposals."
            },
            {
              "id": "scope-erd-discover-proposed-changes-scoped-proposals",
              "criterion": "urn:change-saga:change-saga:story:erd-discover-proposed-changes:criterion:scoped-proposals",
              "story_revision": "urn:change-saga:change-saga:story:erd-discover-proposed-changes:revision:r1",
              "rationale": "Proposed data entities and relationships can be restricted to one feature's declared scope with the establishing paths."
            }
          ]
        },
        {
          "item": {
            "documentation": {
              "target": "urn:change-saga:change-saga:component:inventory-read-queries",

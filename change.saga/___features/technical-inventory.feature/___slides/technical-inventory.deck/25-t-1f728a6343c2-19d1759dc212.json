            "id": "scope",
            "slide": "ti-query-impl-reads",
            "rank": 10,
            "kind": "node",
            "label": "Declared feature scope",
            "description": "With --feature, candidates are pins reachable from the feature's implementation Items through declared members, holders and relationship destinations at each saved revision, with the paths that put them in scope.",
            "selector": {
              "type": "element",
              "element_id": "scope"
            }
          },
          "evidence": [
            {
              "version": 2,
              "references": [
                {
